{
    debug
    auto_https disable_redirects
}

(common) {
    # Security Headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Proxy all API requests to the Python FastAPI backend
    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }

    # Serve dynamic server info endpoint via FastAPI
    handle /server-info.json {
        rewrite * /api/server-info
        reverse_proxy 127.0.0.1:8000
    }

    # Serve static frontend files
    handle {
        root * /usr/share/caddy
        rewrite /favicon.ico /img/favicon.ico
        try_files {path} {path}.html {path}/ index.html
        file_server
    }
}

http://localhost, http://127.0.0.1, :80 {
    import common
}

https://localhost, https://127.0.0.1, :443 {
    tls internal
    import common
}
